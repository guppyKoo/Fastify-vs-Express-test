# goorm dev Atlas cluster connection string (ask the team for credentials)
MONGO_DB_HOST=mongodb://<user>:<password>@<host1>:27017,<host2>:27017,<host3>:27017/goorm_ide?ssl=true&replicaSet=<rs>&authSource=admin&readPreference=secondaryPreferred
# Dedicated benchmark database name (falls back to the URI default db if unauthorized)
BENCH_DB_NAME=fastify_bench
